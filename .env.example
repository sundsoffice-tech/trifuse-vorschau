# Datenbank. SQLite-Datei relativ zum Ordner prisma/. connection_limit=1 ist bei SQLite Pflicht:
# gemessen 29.10.2026 liefen ohne diese Grenze bei 20 gleichzeitigen Käufern Socket-Timeouts.
# Für Postgres: provider in prisma/schema.prisma umstellen, URL ohne diese Parameter.
DATABASE_URL="file:../data/shop.db?connection_limit=1&socket_timeout=30"

# Oeffentliche Adresse des Shops (fuer Stripe-Rueckleitungen und Links in Mails)
APP_URL="http://localhost:3000"

# Markenname des Marktplatzes (eigene Marke, nicht trifuse)
NEXT_PUBLIC_BRAND_NAME="trifuse.store"

# Kundendienst-Adresse, steht auf Bestellbestätigung und Bestellseiten
SUPPORT_EMAIL="service@trifuse.store"

# Erster Admin-Zugang, wird beim Seed angelegt
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="bitte-aendern"

# Zahlung: "stripe" (echt) oder "test" (Simulation ohne Geldfluss)
PAYMENTS_MODE="test"
STRIPE_SECRET_KEY=""
# Geheimnis des Webhook-Endpunkts https://<domain>/api/webhooks/stripe (Ereignisse: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired, charge.refunded).
# Lokal reicht ein beliebiger Wert wie whsec_lokal_nur_test für npm run test:webhook.
STRIPE_WEBHOOK_SECRET=""

# Standard-Provision in Prozent und Versandpauschale in Cent
DEFAULT_COMMISSION_PERCENT="15"
SHIPPING_FLAT_CENTS="490"
FREE_SHIPPING_FROM_CENTS="7500"


# Mail: "smtp" (echter Versand über SMTP_*), "file" (schreibt Mails als JSON nach data/mails, für Entwicklung und
# Tests) oder "off" (nichts geht raus, bleibt im Postausgang unter /admin/postausgang)
MAIL_MODE="file"
MAIL_FROM="trifuse.store <service@trifuse.store>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
