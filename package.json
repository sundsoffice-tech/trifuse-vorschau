{
  "name": "trifuse-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.mjs",
    "db:fresh": "node scripts/db-fresh.mjs",
    "db:backup": "node scripts/sicherung.mjs",
    "db:restore": "node scripts/wiederherstellen.mjs",
    "db:studio": "prisma studio",
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:parallel": "node test/parallel.mjs",
    "test:pruefung": "node test/pruefung.mjs",
    "test:webhook": "node test/webhook.mjs",
    "test:sicherung": "node test/sicherung.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^8.0.2",
    "next": "16.4.3",
    "nodemailer": "^7.0.13",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
